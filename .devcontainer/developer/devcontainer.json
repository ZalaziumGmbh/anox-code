{
  "name": "anox-code (developer)",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": ".."
  },
  "containerUser": "root",
  "remoteUser": "root",
  "init": true,
  "runArgs": [
    "--security-opt=no-new-privileges",
    "--volume=${localEnv:HOME}${localEnv:USERPROFILE}/.ssh/github-plx:/root/.ssh/id_rsa:ro",
    "--volume=${localEnv:HOME}${localEnv:USERPROFILE}/.ssh/known_hosts:/root/.ssh/known_hosts:ro",
    "--name=anox-code${localEnv:ZALAZIUM_DEV_SUFFIX}"
  ],
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "workspaceFolder": "/workspace",
  "forwardPorts": [
    8000
  ],
  "portsAttributes": {
    "8000": {
      "label": "App",
      "onAutoForward": "openBrowser"
    }
  },
  "mounts": [
    "source=anox-code${localEnv:ZALAZIUM_DEV_SUFFIX}-volume,target=/persist,type=volume"
  ],
  "postCreateCommand": "python3 .devcontainer/check-ai.py && pi --setup",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.debugpy",
        "charliermarsh.ruff"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/opt/venv/bin/python",
        "python.terminal.activateEnvironment": false,
        "terminal.integrated.defaultProfile.linux": "bash",
        "editor.formatOnSave": true,
        "files.eol": "\n",
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff"
        }
      }
    }
  },
  "overrideCommand": true,
  "features": {
    "../features/native-ai": {}
  },
  "containerEnv": {
    "CODEX_HOME": "/persist/codex",
    "CLAUDE_CONFIG_DIR": "/persist/claude",
    "PI_CODING_AGENT_DIR": "/persist/pi/agent",
    "DISABLE_AUTOUPDATER": "1"
  },
  "postStartCommand": "python3 .devcontainer/check-ai.py",
  "remoteEnv": {
    "PATH": "/usr/local/bin:/root/.local/bin:${containerEnv:PATH}"
  }
}
