{
  "name": "anox-code",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "containerUser": "root",
  "remoteUser": "root",
  "init": true,
  "runArgs": [
    "--security-opt=no-new-privileges",
    "--volume=${localEnv:HOME}${localEnv:USERPROFILE}/.ssh/github-plx:/root/.ssh/id_rsa:ro",
    "--volume=${localEnv:HOME}${localEnv:USERPROFILE}/.ssh/known_hosts:/root/.ssh/known_hosts:ro",
    "--name=anox-code${localEnv:ZALAZIUM_DEV_SUFFIX}"
  ],
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "workspaceFolder": "/workspace",
  "forwardPorts": [
    8000
  ],
  "portsAttributes": {
    "8000": {
      "label": "App",
      "onAutoForward": "openBrowser"
    }
  },
  "mounts": [
    "source=anox-code${localEnv:ZALAZIUM_DEV_SUFFIX}-volume,target=/persist,type=volume"
  ],
  "postCreateCommand": "pi --setup",
  "postStartCommand": "python3 .devcontainer/check-ai.py",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.debugpy",
        "charliermarsh.ruff"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/opt/venv/bin/python",
        "python.terminal.activateEnvironment": false,
        "terminal.integrated.defaultProfile.linux": "bash",
        "editor.formatOnSave": true,
        "files.eol": "\n",
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff"
        }
      }
    }
  },
  "overrideCommand": true
}
